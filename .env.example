# Токен бота от @BotFather
BOT_TOKEN=123456789:AAExampleTokenHere

# ID Telegram-пользователя (можно несколько через запятую)
ALLOWED_USER_ID=123456789

# Ключи Groq (несколько — через запятую; ротация при rate limit)
GROQ_API_KEYS=gsk_xxxx1,gsk_xxxx2,gsk_xxxx3

# --- LLM-мозг (Groq, fallback при недоступности Web Bridge) ---
# GROQ_CHAT_MODEL=groq/compound
# GROQ_CHAT_FALLBACK_MODEL=qwen/qwen3.8-27b
# LLM_CONTEXT_SIZE=10

# --- Web Bridge ---
# CDP_URL=http://browser:9222  (в docker-compose уже задан)
# GEMINI_RESPONSE_TIMEOUT=240

# --- Google Docs синк (опционально) ---
# Вариант 1: webhook Google Apps Script
# GOOGLE_DOC_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
# Вариант 2: service account + ID документа
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}
# GOOGLE_DOC_ID=1AbCdEf...
